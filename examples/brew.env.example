# Tokens for brew services (agent + gateway).
# Copy to env (same directory) and replace dummy values. Never commit real secrets.
#   cp "$(brew --prefix)/etc/darial/env.example" "$(brew --prefix)/etc/darial/env"
DARIAL_LOCAL_TOKEN=change-me
DARIAL_GATEWAY_TOKEN=change-me
# DARIAL_OPENAI_API_KEY=
DARIAL_LOG=info
